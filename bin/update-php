#!/usr/bin/env bash

set -Eeuo pipefail

REPO="spechshop/pcg729"
API_URL="https://api.github.com/repos/$REPO/releases/latest"

die() {
    printf '\nErro: %s\n' "$1" >&2
    exit 1
}

command -v curl >/dev/null 2>&1 || die "curl não está instalado."
command -v php >/dev/null 2>&1 || die "nenhum PHP foi encontrado no PATH."
command -v sha256sum >/dev/null 2>&1 || die "sha256sum não está instalado."

PHP_COMMAND="$(command -v php)"
PHP_BIN="$(readlink -f "$PHP_COMMAND" 2>/dev/null || printf '%s' "$PHP_COMMAND")"
CURRENT_VERSION="$("$PHP_BIN" -r 'echo PHP_VERSION;' 2>/dev/null || true)"
CURRENT_MODE="$("$PHP_BIN" -r 'echo PHP_ZTS ? "ZTS" : "NTS";' 2>/dev/null || true)"

[ -n "$CURRENT_VERSION" ] || die "não foi possível identificar a versão do PHP atual."
[ -n "$CURRENT_MODE" ] || die "não foi possível identificar se o PHP atual é ZTS ou NTS."

RELEASE_JSON="$(curl -fsSL --retry 3 "$API_URL")" || die "não foi possível consultar a última release pública."

RELEASE_TAG="$(printf '%s' "$RELEASE_JSON" | "$PHP_BIN" -r '
    $data = json_decode(stream_get_contents(STDIN), true);
    if (!is_array($data)) {
        exit(1);
    }
    echo $data["tag_name"] ?? "";
' 2>/dev/null || true)"

assets=()
urls=()
digests=()

while IFS=$'\t' read -r name url digest; do
    [ -n "$name" ] || continue
    assets+=("$name")
    urls+=("$url")
    digests+=("$digest")
done < <(
    printf '%s' "$RELEASE_JSON" | "$PHP_BIN" -r '
        $data = json_decode(stream_get_contents(STDIN), true);

        if (!is_array($data) || !isset($data["assets"]) || !is_array($data["assets"])) {
            exit(1);
        }

        foreach ($data["assets"] as $asset) {
            $name = (string) ($asset["name"] ?? "");
            $url = (string) ($asset["browser_download_url"] ?? "");
            $digest = (string) ($asset["digest"] ?? "");

            if ($name === "" || $url === "") {
                continue;
            }

            if (preg_match("/^(SHA(1|256|512)SUMS?|checksums?(\\.txt)?|.*\\.(sha1|sha256|sha512|sig|asc))$/i", $name)) {
                continue;
            }

            echo str_replace(["\\t", "\\r", "\\n"], " ", $name), "\t",
                 str_replace(["\\t", "\\r", "\\n"], "", $url), "\t",
                 str_replace(["\\t", "\\r", "\\n"], "", $digest), "\n";
        }
    '
)

[ "${#assets[@]}" -gt 0 ] || die "a última release pública não possui arquivos instaláveis."

labels=("${assets[@]}" "Cancelar")
selected=0

if [ ! -r /dev/tty ]; then
    die "este instalador é interativo e precisa de um terminal."
fi

exec 3</dev/tty
exec 4>/dev/tty

draw_menu() {
    printf '\033[2J\033[H' >&4
    printf 'PCG729 - Atualizador do PHP\n\n' >&4
    printf 'PHP atual\n' >&4
    printf '  Binário: %s\n' "$PHP_BIN" >&4
    printf '  Versão:  %s\n' "$CURRENT_VERSION" >&4
    printf '  Build:    %s\n' "$CURRENT_MODE" >&4

    if [ -n "$RELEASE_TAG" ]; then
        printf '  Release:  %s\n' "$RELEASE_TAG" >&4
    fi

    printf '\nSelecione o arquivo para instalar usando ↑/↓ e Enter:\n\n' >&4

    for i in "${!labels[@]}"; do
        if [ "$i" -eq "$selected" ]; then
            printf '  \033[1;36m> %s\033[0m\n' "${labels[$i]}" >&4
        else
            printf '    %s\n' "${labels[$i]}" >&4
        fi
    done
}

while true; do
    draw_menu

    IFS= read -rsn1 key <&3 || true

    if [ "$key" = $'\x1b' ]; then
        IFS= read -rsn2 -t 0.15 rest <&3 || true

        case "$rest" in
            '[A')
                selected=$((selected - 1))
                if [ "$selected" -lt 0 ]; then
                    selected=$(("${#labels[@]}" - 1))
                fi
                ;;
            '[B')
                selected=$((selected + 1))
                if [ "$selected" -ge "${#labels[@]}" ]; then
                    selected=0
                fi
                ;;
        esac
    elif [ -z "$key" ]; then
        break
    fi
done

if [ "$selected" -eq "${#assets[@]}" ]; then
    printf '\033[2J\033[HCancelado.\n' >&4
    exit 0
fi

ASSET="${assets[$selected]}"
ASSET_URL="${urls[$selected]}"
ASSET_DIGEST="${digests[$selected]}"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

printf '\033[2J\033[H' >&4
printf 'Baixando %s...\n' "$ASSET" >&4

curl -fL --retry 3 "$ASSET_URL" -o "$TMP_DIR/php-new"

if [[ "$ASSET_DIGEST" == sha256:* ]]; then
    EXPECTED_SHA256="${ASSET_DIGEST#sha256:}"
    ACTUAL_SHA256="$(sha256sum "$TMP_DIR/php-new" | awk '{print $1}')"

    if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
        die "a validação SHA-256 falhou para $ASSET."
    fi

    printf 'SHA-256 validado com sucesso.\n' >&4
else
    printf 'Aviso: o GitHub não informou SHA-256 para este asset; seguindo sem validação de digest.\n' >&4
fi

chmod +x "$TMP_DIR/php-new"

printf '\nBinário baixado:\n' >&4
"$TMP_DIR/php-new" -v >&4 || die "o arquivo selecionado não parece ser um executável PHP válido."

install_binary() {
    if [ -w "$PHP_BIN" ] || { [ ! -e "$PHP_BIN" ] && [ -w "$(dirname "$PHP_BIN")" ]; }; then
        install -m 0755 "$TMP_DIR/php-new" "$PHP_BIN"
        return
    fi

    if command -v sudo >/dev/null 2>&1; then
        sudo install -m 0755 "$TMP_DIR/php-new" "$PHP_BIN"
        return
    fi

    die "sem permissão para atualizar $PHP_BIN e sudo não está disponível."
}

printf '\nAtualizando %s com %s...\n' "$PHP_BIN" "$ASSET" >&4
install_binary

printf '\nPHP atualizado com sucesso:\n' >&4
"$PHP_BIN" -v >&4
