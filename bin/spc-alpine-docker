#!/usr/bin/env sh

# This file is using docker to run commands
set -e

# Detect docker can run
if ! which docker >/dev/null; then
  echo "Docker is not installed, please install docker first !"
  exit 1
fi
DOCKER_EXECUTABLE="docker"
# shellcheck disable=SC2046
if [ $(id -u) -ne 0 ]; then
    if ! docker info > /dev/null 2>&1; then
        if [ "$SPC_USE_SUDO" != "yes" ]; then
            echo "Docker command requires sudo"
            # shellcheck disable=SC2039
            echo -n 'To use sudo to run docker, run "export SPC_USE_SUDO=yes" and run command again'
            exit 1
        fi
        DOCKER_EXECUTABLE="sudo docker"
    fi
fi



REQUESTED_ARCH=${SPC_USE_ARCH:-$(uname -m)}
case $REQUESTED_ARCH in
    x86_64|amd64) ARCH=x86_64; PLATFORM=linux/amd64 ;;
    aarch64|arm64) ARCH=aarch64; PLATFORM=linux/arm64 ;;
    *)
        echo "Unsupported Docker architecture: $REQUESTED_ARCH" >&2
        exit 1
        ;;
esac

IMAGE="cwcc-spc-$ARCH-v3"

if [ "$SPC_USE_MIRROR" = "yes" ]; then
    MIRROR_STEP="RUN sed -i -e 's|//dl-cdn.alpinelinux.org/alpine/|//mirrors.tuna.tsinghua.edu.cn/alpine/|' -e 's|//cdn.alpinelinux.org/|//mirrors.tuna.tsinghua.edu.cn/alpine/|' /etc/apk/repositories"
else
    MIRROR_STEP="RUN echo 'Using original repo'"
fi

# Detect docker env is setup
if [ "$($DOCKER_EXECUTABLE image inspect --format '{{.Os}}/{{.Architecture}}' "$IMAGE" 2>/dev/null)" != "$PLATFORM" ]; then
    echo "Docker container does not exist. Building docker image ..."
    $DOCKER_EXECUTABLE build --platform "$PLATFORM" -t "$IMAGE" -f- . <<EOF
FROM alpine:edge
$MIRROR_STEP
RUN apk update && \
    apk upgrade -a && \
    apk add --no-cache \
        autoconf \
        automake \
        gettext \
        bash \
        binutils \
        bison \
        build-base \
        cmake \
        curl \
        file \
        flex \
        g++ \
        gcc \
        git \
        jq \
        libgcc \
        libtool \
        libstdc++ \
        linux-headers \
        m4 \
        make \
        pkgconfig \
        wget \
        xz \
        gettext-dev \
        binutils-gold

WORKDIR /app
COPY ./src /app/src
COPY ./composer.* /app/
COPY ./bin/setup-runtime ./bin/spc ./bin/composer /app/bin/
RUN bin/setup-runtime && bin/php bin/composer install --no-dev
ENV PATH="/app/bin:\$PATH"
EOF
fi

# Check if in ci (local terminal can execute with -it)
if [ -t 0 ]; then
    INTERACT=-it
else
    INTERACT=''
fi

PROJECT_DIR=$(pwd)
ARTIFACT_DIR=$PROJECT_DIR
if [ "$ARCH" = aarch64 ]; then
    ARTIFACT_DIR="$PROJECT_DIR/.spc-docker/$ARCH"
fi

if [ "$SPC_DOCKER_DEBUG" = "yes" ]; then
    set -- "$IMAGE"
else
    set -- "$IMAGE" bin/spc "$@"
fi

for dir in buildroot source dist downloads pkgroot; do
    mkdir -p "$ARTIFACT_DIR/$dir"
    set -- -v "$ARTIFACT_DIR/$dir:/app/$dir" "$@"
done

# INTERACT is empty or the single option -it.
# shellcheck disable=SC2086
$DOCKER_EXECUTABLE run --rm $INTERACT --platform "$PLATFORM" \
    -e "SPC_FIX_DEPLOY_ROOT=$ARTIFACT_DIR" \
    -v "$PROJECT_DIR/config:/app/config" -v "$PROJECT_DIR/src:/app/src" "$@"
