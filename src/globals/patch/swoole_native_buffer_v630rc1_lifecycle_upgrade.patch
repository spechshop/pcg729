+    zend_array *volatile owned_peer = nullptr;
+    RETVAL_FALSE;
+    // Zend bailout skips C++ destructors. Keep guard/ts unchanged after setjmp
+    // and restore both explicitly in the catch, before propagating the bailout.
+    zend_try {
+        // A private extra byte detects datagrams larger than the fixed capacity.
+        // Keep Swoole's receive, reactor, cancellation and concurrency checks.
+        ssize_t bytes = sock->socket->recvfrom(buffer->data, buffer->capacity + 1);
+        if (bytes >= 0 && static_cast<size_t>(bytes) > buffer->capacity) {
+            sock->socket->set_err(EMSGSIZE);
+            bytes = -1;
+        }
+        socket_coro_sync_properties(ZEND_THIS, sock);
+        if (bytes >= 0) {
+            // Only metadata uses PHP strings, including for empty datagrams.
+            // owned_peer is volatile because ownership changes after setjmp.
+            owned_peer = zend_new_array(0);
+            zval peer;
+            ZVAL_ARR(&peer, owned_peer);
+            add_assoc_string(&peer, "address", (char *) sock->socket->get_addr());
+            add_assoc_long(&peer, "port", sock->socket->get_port());
