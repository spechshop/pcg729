+static zend_result buffer_read_acquire(zend_object *source, swoole_buffer_read_view_v1 *view) {
+    if (view != nullptr) {
+        *view = {};
+    }
+    if (UNEXPECTED(EG(exception))) {
+        return FAILURE;
+    }
+    // Validate the public Zend identity BEFORE touching our private layout.
+    if (UNEXPECTED(view == nullptr || source == nullptr || buffer_read_api == nullptr ||
+                   source->ce != swoole_buffer_ce || source->handlers != &swoole_buffer_handlers)) {
+        zend_throw_error(nullptr, "Invalid Swoole\\Buffer native read source or view");
+        return FAILURE;
+    }
+    auto *buffer = buffer_fetch_object(source);
+    if (UNEXPECTED(buffer->data == nullptr || buffer->capacity == 0 ||
+                   buffer->capacity > static_cast<size_t>(ZEND_LONG_MAX) || buffer->length > buffer->capacity)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer must have valid constructed storage before native read");
+        return FAILURE;
+    }
+    if (UNEXPECTED(buffer->receiving || buffer->read_token != 0)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has a pending receive or active native read");
+        return FAILURE;
+    }
+    if (UNEXPECTED(buffer_next_token == UINTPTR_MAX)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer native read token space exhausted");
+        return FAILURE;
+    }
+
+    // No fallible operations after acquiring these resources. A caller pin must
+    // outlive this additional producer reference, including on Zend bailout.
+    GC_ADDREF(source);
+    buffer->read_thread = &buffer_thread_identity;
+    buffer->read_token = ++buffer_next_token;
+    ++buffer_active_reads;
+    zend_fiber_switch_block();
+    view->source = source;
+    view->data = buffer->length == 0 ? nullptr : reinterpret_cast<const unsigned char *>(buffer->data);
+    view->length = buffer->length;
+    view->capacity = buffer->capacity;
+    view->token = reinterpret_cast<void *>(buffer->read_token);
+    return SUCCESS;
+}
+
+static void buffer_read_release(zend_object *source, void *token) {
+    if (source == nullptr || source->ce != swoole_buffer_ce || source->handlers != &swoole_buffer_handlers) {
+        return;
+    }
+    auto *buffer = buffer_fetch_object(source);
+    if (buffer->read_token == 0 || buffer->read_thread != &buffer_thread_identity ||
+        token != reinterpret_cast<void *>(buffer->read_token)) {
+        return;
+    }
+    buffer->read_token = 0;
+    buffer->read_thread = nullptr;
+    --buffer_active_reads;
+    zend_fiber_switch_unblock();
+    // The mandatory caller pin prevents destruction/PHP reentry here.
+    ZEND_ASSERT(GC_REFCOUNT(source) >= 2);
+    GC_DELREF(source);
+}
+
+extern "C" SWOOLE_BUFFER_C_API uint32_t swoole_buffer_read_api_version(void) {
+    return SWOOLE_BUFFER_READ_API_VERSION;
+}
+
+extern "C" SWOOLE_BUFFER_C_API const swoole_buffer_read_api_v1 *swoole_buffer_get_read_api(
+    uint32_t api_version, size_t expected_struct_size) {
+    if (api_version != SWOOLE_BUFFER_READ_API_VERSION || expected_struct_size != sizeof(swoole_buffer_read_api_v1)) {
+        return nullptr;
+    }
+    return buffer_read_api;
+}
+
+extern "C" SWOOLE_BUFFER_C_API zend_result swoole_buffer_with_read_view_v1(
+    zval *source, size_t offset, size_t length, swoole_buffer_read_handler_v1 handler, void *context) {
+    if (UNEXPECTED(EG(exception))) {
+        return FAILURE;
+    }
+    if (source != nullptr) {
+        ZVAL_DEREF(source);
+    }
+    if (source == nullptr || Z_TYPE_P(source) != IS_OBJECT || handler == nullptr) {
+        zend_value_error("Native buffer read requires an object and a handler");
+        return FAILURE;
+    }
+    zend_object *object = Z_OBJ_P(source);
+    swoole_buffer_read_view_v1 view = {};
+    zend_result result;
+    GC_ADDREF(object);
+    // acquire may throw (and exception allocation may bail out), but never
+    // bails out after activating the borrow. Do not read view in this catch.
+    zend_try {
+        result = buffer_read_acquire(object, &view);
+    } zend_catch {
+        OBJ_RELEASE(object);
+        zend_bailout();
+    } zend_end_try();
+    if (result != SUCCESS) {
+        OBJ_RELEASE(object);
+        return FAILURE;
+    }
+    if (offset > view.length || (length != SIZE_MAX && length > view.length - offset)) {
+        buffer_read_release(object, view.token);
+        OBJ_RELEASE(object);
+        zend_value_error("Native buffer read slice exceeds valid bytes");
+        return FAILURE;
+    }
+    size_t slice_length = length == SIZE_MAX ? view.length - offset : length;
+    // Never do arithmetic on a NULL pointer, even for an empty buffer/slice.
+    view.data = slice_length == 0 ? nullptr : view.data + offset;
+    view.length = slice_length;
+
+    // object/view/token are established before setjmp and unchanged afterwards.
+    // result is used only on the normal return path. C++ exceptions are not ABI
+    // compliant; contain them as Errors while still releasing our resources.
+    zend_try {
+        try {
+            result = handler(&view, context);
+        } catch (...) {
+            zend_throw_error(nullptr, "Native buffer reader threw a C++ exception");
+            result = FAILURE;
+        }
+    } zend_catch {
+        buffer_read_release(object, view.token);
+        OBJ_RELEASE(object);
+        zend_bailout();
+    } zend_end_try();
+    buffer_read_release(object, view.token);
+    OBJ_RELEASE(object);
+    if (result != SUCCESS || EG(exception)) {
+        if (!EG(exception)) {
+            zend_throw_error(nullptr, "Native buffer reader failed without an exception");
+        }
+        return FAILURE;
+    }
+    return SUCCESS;
+}
+
+void php_swoole_buffer_mshutdown() {
+    buffer_read_api = nullptr;
+}
