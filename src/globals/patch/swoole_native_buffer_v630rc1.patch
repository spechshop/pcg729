+#define SWOOLE_BUFFER_C_API_BUILD
+#include "swoole_buffer_c_api.h"
+#include "php_swoole_buffer.h"
+
+BEGIN_EXTERN_C()
+#include "Zend/zend_fibers.h"
+END_EXTERN_C()
+
+#include <cstdlib>
+#include <limits>
+
+BEGIN_EXTERN_C()
+#include "stubs/php_swoole_buffer_arginfo.h"
+END_EXTERN_C()
+
+zend_class_entry *swoole_buffer_ce;
+static zend_object_handlers swoole_buffer_handlers;
+static const swoole_buffer_read_api_v1 *buffer_read_api;
+// No request object or address is stored in process-global API state.
+static thread_local char buffer_thread_identity;
+static thread_local uintptr_t buffer_next_token;
+static thread_local size_t buffer_active_reads;
+
+bool php_swoole_buffer_read_active() {
+    return buffer_active_reads != 0;
+}
+
+static SwooleBufferObject *buffer_fetch_object(zend_object *object) {
+    return reinterpret_cast<SwooleBufferObject *>(reinterpret_cast<char *>(object) -
+                                                  XtOffsetOf(SwooleBufferObject, std));
+}
+
+SwooleBufferObject *php_swoole_buffer_get(zval *zbuffer) {
+    zend_object *source = Z_OBJ_P(zbuffer);
+    if (UNEXPECTED(source->ce != swoole_buffer_ce || source->handlers != &swoole_buffer_handlers)) {
+        zend_throw_error(nullptr, "Invalid Swoole\\Buffer object");
+        return nullptr;
+    }
+    auto *buffer = buffer_fetch_object(source);
+    if (UNEXPECTED(buffer->data == nullptr)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer must be constructed before use");
+        return nullptr;
+    }
+    return buffer;
+}
+
+static zend_object *buffer_create_object(zend_class_entry *ce) {
+    auto *buffer = static_cast<SwooleBufferObject *>(zend_object_alloc(sizeof(SwooleBufferObject), ce));
+    buffer->data = nullptr;
+    buffer->capacity = 0;
+    buffer->length = 0;
+    buffer->receiving = false;
+    buffer->read_token = 0;
+    buffer->read_thread = nullptr;
+    zend_object_std_init(&buffer->std, ce);
+    object_properties_init(&buffer->std, ce);
+    buffer->std.handlers = &swoole_buffer_handlers;
+    return &buffer->std;
+}
+
+static void buffer_free_object(zend_object *object) {
+    auto *buffer = buffer_fetch_object(object);
+    std::free(buffer->data);
+    buffer->data = nullptr;
+    buffer->capacity = 0;
+    buffer->length = 0;
+    zend_object_std_dtor(object);
+}
+
+SW_EXTERN_C_BEGIN
+static PHP_METHOD(swoole_buffer, __construct) {
+    zend_long capacity;
+    ZEND_PARSE_PARAMETERS_START(1, 1)
+    Z_PARAM_LONG(capacity)
+    ZEND_PARSE_PARAMETERS_END();
+
+    auto *buffer = buffer_fetch_object(Z_OBJ_P(ZEND_THIS));
+    if (UNEXPECTED(buffer->read_token != 0)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has an active native read");
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(buffer->data != nullptr)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer is already constructed");
+        RETURN_THROWS();
+    }
+    // Reserve one private byte for datagram overflow detection; neither the
+    // allocation nor the recvfrom result may overflow size_t/ssize_t/PHP int.
+    if (capacity <= 0 ||
+        static_cast<zend_ulong>(capacity) >= std::numeric_limits<size_t>::max() ||
+        static_cast<zend_ulong>(capacity) >= static_cast<zend_ulong>(std::numeric_limits<ssize_t>::max()) ||
+        static_cast<zend_ulong>(capacity) > ZSTR_MAX_LEN) {
+        zend_argument_value_error(1, "must be a positive capacity with room for one overflow byte");
+        RETURN_THROWS();
+    }
+
+    auto *data = static_cast<char *>(std::malloc(static_cast<size_t>(capacity) + 1));
+    if (UNEXPECTED(data == nullptr)) {
+        zend_throw_exception(swoole_exception_ce, "Swoole\\Buffer allocation failed", ENOMEM);
+        RETURN_THROWS();
+    }
+    buffer->data = data;
+    buffer->capacity = static_cast<size_t>(capacity);
+}
+
+static PHP_METHOD(swoole_buffer, getCapacity) {
+    ZEND_PARSE_PARAMETERS_NONE();
+    auto *buffer = php_swoole_buffer_get(ZEND_THIS);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    RETURN_LONG(static_cast<zend_long>(buffer->capacity));
+}
+
+static PHP_METHOD(swoole_buffer, getLength) {
+    ZEND_PARSE_PARAMETERS_NONE();
+    auto *buffer = php_swoole_buffer_get(ZEND_THIS);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    RETURN_LONG(static_cast<zend_long>(buffer->length));
+}
+
+static PHP_METHOD(swoole_buffer, clear) {
+    ZEND_PARSE_PARAMETERS_NONE();
+    auto *buffer = php_swoole_buffer_get(ZEND_THIS);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(buffer->read_token != 0)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has an active native read");
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(buffer->receiving)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has a pending receive");
+        RETURN_THROWS();
+    }
+    buffer->length = 0;
+    RETURN_NULL();
+}
+
+static PHP_METHOD(swoole_buffer, toString) {
+    ZEND_PARSE_PARAMETERS_NONE();
+    auto *buffer = php_swoole_buffer_get(ZEND_THIS);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(buffer->receiving)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has a pending receive");
+        RETURN_THROWS();
+    }
+    RETURN_STRINGL(buffer->data, buffer->length);
+}
+SW_EXTERN_C_END
+
+static const zend_function_entry swoole_buffer_methods[] = {
+    PHP_ME(swoole_buffer, __construct, arginfo_class_Swoole_Buffer___construct, ZEND_ACC_PUBLIC)
+    PHP_ME(swoole_buffer, getCapacity, arginfo_class_Swoole_Buffer_getCapacity, ZEND_ACC_PUBLIC)
+    PHP_ME(swoole_buffer, getLength, arginfo_class_Swoole_Buffer_getLength, ZEND_ACC_PUBLIC)
+    PHP_ME(swoole_buffer, clear, arginfo_class_Swoole_Buffer_clear, ZEND_ACC_PUBLIC)
+    PHP_ME(swoole_buffer, toString, arginfo_class_Swoole_Buffer_toString, ZEND_ACC_PUBLIC)
+    PHP_FE_END
+};
+
+static zend_result buffer_read_acquire(zend_object *source, swoole_buffer_read_view_v1 *view) {
+    if (view != nullptr) {
+        *view = {};
+    }
+    if (UNEXPECTED(EG(exception))) {
+        return FAILURE;
+    }
+    // Validate the public Zend identity BEFORE touching our private layout.
+    if (UNEXPECTED(view == nullptr || source == nullptr || buffer_read_api == nullptr ||
+                   source->ce != swoole_buffer_ce || source->handlers != &swoole_buffer_handlers)) {
+        zend_throw_error(nullptr, "Invalid Swoole\\Buffer native read source or view");
+        return FAILURE;
+    }
+    auto *buffer = buffer_fetch_object(source);
+    if (UNEXPECTED(buffer->data == nullptr || buffer->capacity == 0 ||
+                   buffer->capacity > static_cast<size_t>(ZEND_LONG_MAX) || buffer->length > buffer->capacity)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer must have valid constructed storage before native read");
+        return FAILURE;
+    }
+    if (UNEXPECTED(buffer->receiving || buffer->read_token != 0)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has a pending receive or active native read");
+        return FAILURE;
+    }
+    if (UNEXPECTED(buffer_next_token == UINTPTR_MAX)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer native read token space exhausted");
+        return FAILURE;
+    }
+
+    // No fallible operations after acquiring these resources. A caller pin must
+    // outlive this additional producer reference, including on Zend bailout.
+    GC_ADDREF(source);
+    buffer->read_thread = &buffer_thread_identity;
+    buffer->read_token = ++buffer_next_token;
+    ++buffer_active_reads;
+    zend_fiber_switch_block();
+    view->source = source;
+    view->data = buffer->length == 0 ? nullptr : reinterpret_cast<const unsigned char *>(buffer->data);
+    view->length = buffer->length;
+    view->capacity = buffer->capacity;
+    view->token = reinterpret_cast<void *>(buffer->read_token);
+    return SUCCESS;
+}
+
+static void buffer_read_release(zend_object *source, void *token) {
+    if (source == nullptr || source->ce != swoole_buffer_ce || source->handlers != &swoole_buffer_handlers) {
+        return;
+    }
+    auto *buffer = buffer_fetch_object(source);
+    if (buffer->read_token == 0 || buffer->read_thread != &buffer_thread_identity ||
+        token != reinterpret_cast<void *>(buffer->read_token)) {
+        return;
+    }
+    buffer->read_token = 0;
+    buffer->read_thread = nullptr;
+    --buffer_active_reads;
+    zend_fiber_switch_unblock();
+    // The mandatory caller pin prevents destruction/PHP reentry here.
+    ZEND_ASSERT(GC_REFCOUNT(source) >= 2);
+    GC_DELREF(source);
+}
+
+extern "C" SWOOLE_BUFFER_C_API uint32_t swoole_buffer_read_api_version(void) {
+    return SWOOLE_BUFFER_READ_API_VERSION;
+}
+
+extern "C" SWOOLE_BUFFER_C_API const swoole_buffer_read_api_v1 *swoole_buffer_get_read_api(
+    uint32_t api_version, size_t expected_struct_size) {
+    if (api_version != SWOOLE_BUFFER_READ_API_VERSION || expected_struct_size != sizeof(swoole_buffer_read_api_v1)) {
+        return nullptr;
+    }
+    return buffer_read_api;
+}
+
+extern "C" SWOOLE_BUFFER_C_API zend_result swoole_buffer_with_read_view_v1(
+    zval *source, size_t offset, size_t length, swoole_buffer_read_handler_v1 handler, void *context) {
+    if (UNEXPECTED(EG(exception))) {
+        return FAILURE;
+    }
+    if (source != nullptr) {
+        ZVAL_DEREF(source);
+    }
+    if (source == nullptr || Z_TYPE_P(source) != IS_OBJECT || handler == nullptr) {
+        zend_value_error("Native buffer read requires an object and a handler");
+        return FAILURE;
+    }
+    zend_object *object = Z_OBJ_P(source);
+    swoole_buffer_read_view_v1 view = {};
+    zend_result result;
+    GC_ADDREF(object);
+    // acquire may throw (and exception allocation may bail out), but never
+    // bails out after activating the borrow. Do not read view in this catch.
+    zend_try {
+        result = buffer_read_acquire(object, &view);
+    } zend_catch {
+        OBJ_RELEASE(object);
+        zend_bailout();
+    } zend_end_try();
+    if (result != SUCCESS) {
+        OBJ_RELEASE(object);
+        return FAILURE;
+    }
+    if (offset > view.length || (length != SIZE_MAX && length > view.length - offset)) {
+        buffer_read_release(object, view.token);
+        OBJ_RELEASE(object);
+        zend_value_error("Native buffer read slice exceeds valid bytes");
+        return FAILURE;
+    }
+    size_t slice_length = length == SIZE_MAX ? view.length - offset : length;
+    // Never do arithmetic on a NULL pointer, even for an empty buffer/slice.
+    view.data = slice_length == 0 ? nullptr : view.data + offset;
+    view.length = slice_length;
+
+    // object/view/token are established before setjmp and unchanged afterwards.
+    // result is used only on the normal return path. C++ exceptions are not ABI
+    // compliant; contain them as Errors while still releasing our resources.
+    zend_try {
+        try {
+            result = handler(&view, context);
+        } catch (...) {
+            zend_throw_error(nullptr, "Native buffer reader threw a C++ exception");
+            result = FAILURE;
+        }
+    } zend_catch {
+        buffer_read_release(object, view.token);
+        OBJ_RELEASE(object);
+        zend_bailout();
+    } zend_end_try();
+    buffer_read_release(object, view.token);
+    OBJ_RELEASE(object);
+    if (result != SUCCESS || EG(exception)) {
+        if (!EG(exception)) {
+            zend_throw_error(nullptr, "Native buffer reader failed without an exception");
+        }
+        return FAILURE;
+    }
+    return SUCCESS;
+}
+
+void php_swoole_buffer_mshutdown() {
+    buffer_read_api = nullptr;
+}
+
+void php_swoole_buffer_minit(int module_number) {
+    SW_INIT_CLASS_ENTRY_STD(swoole_buffer, "Swoole\\Buffer", swoole_buffer_methods);
+    swoole_buffer_ce->ce_flags |= ZEND_ACC_FINAL;
+#ifdef ZEND_ACC_NO_DYNAMIC_PROPERTIES
+    swoole_buffer_ce->ce_flags |= ZEND_ACC_NO_DYNAMIC_PROPERTIES;
+#endif
+    SW_SET_CLASS_NOT_SERIALIZABLE(swoole_buffer);
+    SW_SET_CLASS_CLONEABLE(swoole_buffer, sw_zend_class_clone_deny);
+    SW_SET_CLASS_CUSTOM_OBJECT(swoole_buffer, buffer_create_object, buffer_free_object, SwooleBufferObject, std);
+    // Written only at module startup, immutable until all dependents shut down.
+    static swoole_buffer_read_api_v1 api;
+    api = {
+        SWOOLE_BUFFER_READ_API_VERSION, sizeof(swoole_buffer_read_api_v1),
+        swoole_buffer_ce, buffer_read_acquire, buffer_read_release
+    };
+    buffer_read_api = &api;
+}
