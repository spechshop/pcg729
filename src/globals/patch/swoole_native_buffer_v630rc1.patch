+
+#include "php_swoole_buffer.h"
+
+#include <cstdlib>
+#include <limits>
+
+BEGIN_EXTERN_C()
+#include "stubs/php_swoole_buffer_arginfo.h"
+END_EXTERN_C()
+
+zend_class_entry *swoole_buffer_ce;
+static zend_object_handlers swoole_buffer_handlers;
+
+static SwooleBufferObject *buffer_fetch_object(zend_object *object) {
+    return reinterpret_cast<SwooleBufferObject *>(reinterpret_cast<char *>(object) -
+                                                  XtOffsetOf(SwooleBufferObject, std));
+}
+
+SwooleBufferObject *php_swoole_buffer_get(zval *zbuffer) {
+    auto *buffer = buffer_fetch_object(Z_OBJ_P(zbuffer));
+    if (UNEXPECTED(buffer->data == nullptr)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer must be constructed before use");
+        return nullptr;
+    }
+    return buffer;
+}
+
+static zend_object *buffer_create_object(zend_class_entry *ce) {
+    auto *buffer = static_cast<SwooleBufferObject *>(zend_object_alloc(sizeof(SwooleBufferObject), ce));
+    buffer->data = nullptr;
+    buffer->capacity = 0;
+    buffer->length = 0;
+    buffer->receiving = false;
+    zend_object_std_init(&buffer->std, ce);
+    object_properties_init(&buffer->std, ce);
+    buffer->std.handlers = &swoole_buffer_handlers;
+    return &buffer->std;
+}
+
+static void buffer_free_object(zend_object *object) {
+    auto *buffer = buffer_fetch_object(object);
+    std::free(buffer->data);
+    buffer->data = nullptr;
+    buffer->capacity = 0;
+    buffer->length = 0;
+    zend_object_std_dtor(object);
+}
+
+SW_EXTERN_C_BEGIN
+static PHP_METHOD(swoole_buffer, __construct) {
+    zend_long capacity;
+    ZEND_PARSE_PARAMETERS_START(1, 1)
+    Z_PARAM_LONG(capacity)
+    ZEND_PARSE_PARAMETERS_END();
+
+    auto *buffer = buffer_fetch_object(Z_OBJ_P(ZEND_THIS));
+    if (UNEXPECTED(buffer->data != nullptr)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer is already constructed");
+        RETURN_THROWS();
+    }
+    // Reserve one private byte for datagram overflow detection; neither the
+    // allocation nor the recvfrom result may overflow size_t/ssize_t/PHP int.
+    if (capacity <= 0 ||
+        static_cast<zend_ulong>(capacity) >= std::numeric_limits<size_t>::max() ||
+        static_cast<zend_ulong>(capacity) >= static_cast<zend_ulong>(std::numeric_limits<ssize_t>::max()) ||
+        static_cast<zend_ulong>(capacity) > ZSTR_MAX_LEN) {
+        zend_argument_value_error(1, "must be a positive capacity with room for one overflow byte");
+        RETURN_THROWS();
+    }
+
+    auto *data = static_cast<char *>(std::malloc(static_cast<size_t>(capacity) + 1));
+    if (UNEXPECTED(data == nullptr)) {
+        zend_throw_exception(swoole_exception_ce, "Swoole\\Buffer allocation failed", ENOMEM);
+        RETURN_THROWS();
+    }
+    buffer->data = data;
+    buffer->capacity = static_cast<size_t>(capacity);
+}
+
+static PHP_METHOD(swoole_buffer, getCapacity) {
+    ZEND_PARSE_PARAMETERS_NONE();
+    auto *buffer = php_swoole_buffer_get(ZEND_THIS);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    RETURN_LONG(static_cast<zend_long>(buffer->capacity));
+}
+
+static PHP_METHOD(swoole_buffer, getLength) {
+    ZEND_PARSE_PARAMETERS_NONE();
+    auto *buffer = php_swoole_buffer_get(ZEND_THIS);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    RETURN_LONG(static_cast<zend_long>(buffer->length));
+}
+
+static PHP_METHOD(swoole_buffer, clear) {
+    ZEND_PARSE_PARAMETERS_NONE();
+    auto *buffer = php_swoole_buffer_get(ZEND_THIS);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(buffer->receiving)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has a pending receive");
+        RETURN_THROWS();
+    }
+    buffer->length = 0;
+    RETURN_NULL();
+}
+
+static PHP_METHOD(swoole_buffer, toString) {
+    ZEND_PARSE_PARAMETERS_NONE();
+    auto *buffer = php_swoole_buffer_get(ZEND_THIS);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(buffer->receiving)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has a pending receive");
+        RETURN_THROWS();
+    }
+    RETURN_STRINGL(buffer->data, buffer->length);
+}
+SW_EXTERN_C_END
+
+static const zend_function_entry swoole_buffer_methods[] = {
+    PHP_ME(swoole_buffer, __construct, arginfo_class_Swoole_Buffer___construct, ZEND_ACC_PUBLIC)
+    PHP_ME(swoole_buffer, getCapacity, arginfo_class_Swoole_Buffer_getCapacity, ZEND_ACC_PUBLIC)
+    PHP_ME(swoole_buffer, getLength, arginfo_class_Swoole_Buffer_getLength, ZEND_ACC_PUBLIC)
+    PHP_ME(swoole_buffer, clear, arginfo_class_Swoole_Buffer_clear, ZEND_ACC_PUBLIC)
+    PHP_ME(swoole_buffer, toString, arginfo_class_Swoole_Buffer_toString, ZEND_ACC_PUBLIC)
+    PHP_FE_END
+};
+
+void php_swoole_buffer_minit(int module_number) {
+    SW_INIT_CLASS_ENTRY_STD(swoole_buffer, "Swoole\\Buffer", swoole_buffer_methods);
+    swoole_buffer_ce->ce_flags |= ZEND_ACC_FINAL;
+#ifdef ZEND_ACC_NO_DYNAMIC_PROPERTIES
+    swoole_buffer_ce->ce_flags |= ZEND_ACC_NO_DYNAMIC_PROPERTIES;
+#endif
+    SW_SET_CLASS_NOT_SERIALIZABLE(swoole_buffer);
+    SW_SET_CLASS_CLONEABLE(swoole_buffer, sw_zend_class_clone_deny);
+    SW_SET_CLASS_CUSTOM_OBJECT(swoole_buffer, buffer_create_object, buffer_free_object, SwooleBufferObject, std);
+}
