@@ -115,0 +118 @@
+    PHP_ME(swoole_socket_coro, recvfromInto,   arginfo_class_Swoole_Coroutine_Socket_recvfromInto,   ZEND_ACC_PUBLIC)
@@ -1822,0 +1826,77 @@
+static PHP_METHOD(swoole_socket_coro, recvfromInto) {
+    zval *zbuffer, *peername;
+    double timeout = 0;
+
+    ZEND_PARSE_PARAMETERS_START(2, 3)
+    Z_PARAM_OBJECT_OF_CLASS(zbuffer, swoole_buffer_ce)
+    Z_PARAM_ZVAL(peername)
+    Z_PARAM_OPTIONAL
+    Z_PARAM_DOUBLE(timeout)
+    ZEND_PARSE_PARAMETERS_END_EX(RETURN_FALSE);
+
+    swoole_get_socket_coro(sock, ZEND_THIS);
+    auto *buffer = php_swoole_buffer_get(zbuffer);
+    if (UNEXPECTED(buffer == nullptr)) {
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(buffer->read_token != 0)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has an active native read");
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(buffer->receiving)) {
+        zend_throw_error(nullptr, "Swoole\\Buffer has a pending receive");
+        RETURN_THROWS();
+    }
+    if (UNEXPECTED(!sock->socket->get_socket()->is_dgram())) {
+        sock->socket->set_err(EPROTONOSUPPORT);
+        socket_coro_sync_properties(ZEND_THIS, sock);
+        RETURN_FALSE;
+    }
+
+    // Own both objects independently of PHP variables/references throughout the
+    // yield and peer assignment. The guard also releases the buffer on errors.
+    struct ReceiveGuard {
+        SwooleBufferObject *buffer;
+        zend_object *socket_object;
+        ReceiveGuard(SwooleBufferObject *buffer, zend_object *socket_object)
+            : buffer(buffer), socket_object(socket_object) {
+            GC_ADDREF(&buffer->std);
+            GC_ADDREF(socket_object);
+            buffer->receiving = true;
+            buffer->length = 0;
+        }
+        ~ReceiveGuard() {
+            buffer->receiving = false;
+            OBJ_RELEASE(socket_object);
+            OBJ_RELEASE(&buffer->std);
+        }
+    } guard(buffer, Z_OBJ_P(ZEND_THIS));
+
+    SocketImpl::TimeoutSetter ts(sock->socket, timeout, SW_TIMEOUT_READ);
+    // A private extra byte distinguishes an exact fit from every oversized
+    // datagram on recvfrom implementations that return only the copied length.
+    // Use Swoole's existing receive, reactor, cancellation and concurrency checks.
+    ssize_t bytes = sock->socket->recvfrom(buffer->data, buffer->capacity + 1);
+    if (bytes >= 0 && static_cast<size_t>(bytes) > buffer->capacity) {
+        sock->socket->set_err(EMSGSIZE);
+        bytes = -1;
+    }
+    socket_coro_sync_properties(ZEND_THIS, sock);
+    if (bytes < 0) {
+        RETURN_FALSE;
+    }
+
+    // Only peer metadata uses PHP strings; the payload stays in native storage.
+    // Zero-byte UDP datagrams are successful receives and still have a sender.
+    zval peer;
+    array_init(&peer);
+    add_assoc_string(&peer, "address", (char *) sock->socket->get_addr());
+    add_assoc_long(&peer, "port", sock->socket->get_port());
+    ZEND_TRY_ASSIGN_VALUE(peername, &peer);
+    if (UNEXPECTED(EG(exception))) {
+        RETURN_THROWS();
+    }
+    buffer->length = static_cast<size_t>(bytes);
+    RETURN_LONG(static_cast<zend_long>(bytes));
+}
